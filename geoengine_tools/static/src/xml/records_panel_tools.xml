<?xml version="1.0" encoding="utf-8" ?>
<templates>
    <t
        t-name="geoengine_tools.RecordsPanelDrawOnRecord"
        t-inherit="base_geoengine.RecordsPanel"
        t-inherit-mode="extension"
    >
        <xpath
            expr="//button[@t-on-click=&quot;() =&gt; this.props.zoomOnFeature(record)&quot;]"
            position="after"
        >
            <button
                class="btn btn-search p-0"
                t-on-click="() => this.props.drawOnRecord(record)"
            >
                <i class="fa fa-pencil me-2 text-primary" />
            </button>
        </xpath>
    </t>
</templates>
